{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maikhanhthieu-droid/THIUCUBU/schemas/market_state_history.v1.schema.json",
  "title": "THIEUCUBU Market State History v1",
  "type": "object",
  "required": ["schema_version", "states", "events"],
  "properties": {
    "schema_version": {"const": "thieucubu.market_state_history.v1"},
    "updated_at": {"type": ["string", "null"]},
    "states": {"type": "object"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "symbol", "kind", "from", "to", "score"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
