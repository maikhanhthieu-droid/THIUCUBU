TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
VNSTOCK_API_KEY=
FIINQUANT_USERNAME=
FIINQUANT_PASSWORD=
VIMO_API_KEY=

# Optional FiinQuant safety limits (free plan: 90 requests/minute).
FIINQUANT_REQUESTS_PER_MINUTE=90
FIINQUANT_USAGE_RATIO=0.70
FIINQUANT_MONTHLY_REQUEST_BUDGET=70000
FIINQUANT_MAX_CONCURRENCY=1
FIINQUANT_HTTP_TIMEOUT_SEC=20
FIINQUANT_HISTORY_CHUNK_DAYS=180
FIINQUANT_HISTORY_CHUNK_RETRIES=2
FIINQUANT_RECENT_HISTORY_DAYS=180

# Optional VIMO support flow. It never blocks the core scanner.
VIMO_REQUESTS_PER_MINUTE=10
VIMO_USAGE_RATIO=0.70
VIMO_DAILY_REQUEST_BUDGET=70
VIMO_MAX_WORKERS=2
VIMO_DAILY_MAX_SYMBOLS=8
VIMO_WEEKEND_MAX_SYMBOLS=12

# Intraday bulk-board budget (self-imposed because KBS/VCI publish no quota here).
PULSE_SOURCE_LIMITS=KBS=20,VCI=20
PULSE_SOURCE_USAGE_RATIO=0.70
